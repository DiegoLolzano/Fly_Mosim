def main():
  print("[La Mosca] Inicializando Gamepad virtual...")
  gamepad = vg.VX360Gamepad()
  time.sleep(1.0)

  print("[La Mosca] Conectando receptor de telemetría...")
  telemetry = MoSimTelemetryReceiver(ip="127.0.0.1", port=9999)
  telemetry.start()

  pid_x = PIDController(kp=0.8, kd=0.07)
  pid_z = PIDController(kp=0.8, kd=0.07)
  pid_yaw = PIDController(kp=0.035, ki=0.001, kd=0.004)

  print("Esperando telemetría...")
  while True:
    pose = telemetry.get_pose()
    if pose.name:
      print(
          f"Conectado a: {pose.name} en ({pose.x:.2f}, {pose.z:.2f}) | hasCoral:"
          f" {pose.has_coral}"
      )
      break
    time.sleep(0.05)

  tolerance_pos = 0.20
  tolerance_yaw = 6.0
  timeout_por_waypoint = 4.5

  try:
    for idx, step in enumerate(RUTINA):
      wp = step["target"]
      action = step["action"]
      dwell_time = step["dwell"]

      if action == "HUNT_CORAL":
        execute_action(gamepad, action, dwell_time, telemetry=telemetry)
        continue

      pid_x.reset()
      pid_z.reset()
      pid_yaw.reset()

      print(
          f"\n>>> Paso {idx + 1}/{len(RUTINA)}: Navegando hacia"
          f" '{wp['name']}'..."
      )
      start_wp_time = time.time()
      prev_dist = 999.0
      stuck_cycles = 0

      while True:
        t0 = time.time()
        pose = telemetry.get_pose()

        err_x = wp["x"] - pose.x
        err_z = wp["z"] - pose.z
        dist = math.hypot(err_x, err_z)
        err_yaw = normalize_angle(wp["yaw"] - pose.yaw)

        if abs(prev_dist - dist) < 0.005 and dist < 0.28:
          stuck_cycles += 1
        else:
          stuck_cycles = 0
        prev_dist = dist

        tiempo_transcurrido = time.time() - start_wp_time

        llegada_normal = dist < tolerance_pos and abs(err_yaw) < tolerance_yaw
        llegada_por_friccion = stuck_cycles > 15 and dist < 0.25
        llegada_por_timeout = tiempo_transcurrido > timeout_por_waypoint

        if llegada_normal or llegada_por_friccion or llegada_por_timeout:
          gamepad.left_joystick_float(0.0, 0.0)
          gamepad.right_joystick_float(0.0, 0.0)
          gamepad.update()
          break

        yaw_rad = math.radians(pose.yaw)
        local_forward = err_z * math.cos(yaw_rad) + err_x * math.sin(yaw_rad)
        local_strafe = err_x * math.cos(yaw_rad) - err_z * math.sin(yaw_rad)

        cmd_forward = clamp(pid_z.calculate(local_forward))
        cmd_strafe = clamp(pid_x.calculate(local_strafe))

        raw_turn = pid_yaw.calculate(err_yaw)
        min_turn_power = 0.11
        if abs(err_yaw) > tolerance_yaw:
          cmd_turn = clamp(
              max(raw_turn, min_turn_power)
              if raw_turn > 0
              else min(raw_turn, -min_turn_power)
          )
        else:
          cmd_turn = 0.0

        gamepad.left_joystick_float(
            x_value_float=cmd_strafe, y_value_float=cmd_forward
        )
        gamepad.right_joystick_float(x_value_float=cmd_turn, y_value_float=0.0)
        gamepad.update()

        elapsed = time.time() - t0
        time.sleep(max(0.0, 0.02 - elapsed))

      print(f"[Acción en punto] Ejecutando: {action}")
      execute_action(gamepad, action, dwell_time, telemetry=telemetry)

    print("\n\n=== ¡RUTINA COMPLETADA CON ÉXITO! ===")

  except KeyboardInterrupt:
    print("\nAbortado por el usuario.")
  finally:
    gamepad.left_joystick_float(0.0, 0.0)
    gamepad.right_joystick_float(0.0, 0.0)
    gamepad.update()
    telemetry.stop()


if __name__ == "__main__":
  main()